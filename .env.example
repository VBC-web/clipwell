# Public site URL used for canonical links, sitemap, Open Graph and JSON-LD.
# Replace this with the real domain before building for production.
PUBLIC_SITE_URL=https://clipwell.app

# Leave empty when Nginx proxies /api/ to the backend on the same origin.
# Set to a full URL only when the API is served from a separate origin.
PUBLIC_API_BASE_URL=

# Runtime settings for the backend container.
ENVIRONMENT=production
ENABLE_DOCS=false
ALLOWED_ORIGINS=
FRONTEND_PORT=8080
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_JOBS=2
MAX_PENDING_JOBS=20
EXTRACT_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=600
DOWNLOAD_TTL_SECONDS=900
