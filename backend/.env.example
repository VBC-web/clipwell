# Copy to .env and adjust before running the backend locally.

ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Comma-separated browser origins allowed to call the API. Leave empty when the
# frontend and API share an origin through a reverse proxy.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Only enable when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional absolute paths. When omitted, yt-dlp and ffmpeg are found on PATH.
YTDLP_PATH=
FFMPEG_LOCATION=
TEMP_DIR=

EXTRACT_TIMEOUT_SECONDS=60
CAPTION_TIMEOUT_SECONDS=75
JOB_TIMEOUT_SECONDS=600
SOCKET_TIMEOUT_SECONDS=20
MAX_DURATION_SECONDS=14400
MAX_FILE_SIZE_MB=500

MEDIA_TTL_SECONDS=1200
DOWNLOAD_TTL_SECONDS=900
CAPTION_TTL_SECONDS=900

MAX_CONCURRENT_JOBS=2
MAX_PENDING_JOBS=20
MAX_MEDIA_RECORDS=500
MAX_REQUEST_BODY_BYTES=65536
MAX_CAPTION_BYTES=2000000
MAX_DESCRIPTION_CHARS=50000

RATE_EXTRACT_PER_MINUTE=12
RATE_DOWNLOAD_PER_MINUTE=6
RATE_STATUS_PER_MINUTE=180
RATE_CAPTION_PER_MINUTE=10
RATE_FILE_PER_MINUTE=30
