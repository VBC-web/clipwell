---
import PlatformIcon from './PlatformIcon.astro';
import { PLATFORMS } from '../lib/platforms';
import type { PlatformKey } from '../lib/platforms';

interface Props {
  platform: PlatformKey;
  headingLevel?: 'h2' | 'h3';
  compact?: boolean;
}

const { platform, headingLevel = 'h3', compact = false } = Astro.props;
const definition = PLATFORMS[platform];
const Heading = headingLevel;
---

<a
  href={`/${definition.slug}/`}
  class:list={[
    'group flex flex-col border border-line bg-surface p-4 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:shadow-card',
    compact ? 'rounded-md' : 'rounded-lg',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <PlatformIcon platform={platform} />
    <svg
      class="mt-1 h-4 w-4 text-muted transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M8 7h9v9"></path>
    </svg>
  </div>
  <Heading class="mt-4 text-[1.1rem] leading-tight">{definition.name}</Heading>
  <p class="mt-1 text-[0.76rem] font-[650] uppercase tracking-[0.06em] text-accent-ink">Video downloader</p>
  {!compact && <p class="mt-2 text-xs leading-relaxed text-muted">{definition.homeNote}</p>}
</a>
