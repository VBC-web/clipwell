---
import Logo from './Logo.astro';
import PlatformIcon from './PlatformIcon.astro';
import { LEGAL_LINKS, SITE } from '../data/site';
import { PLATFORM_KEYS, PLATFORMS } from '../lib/platforms';

const year = new Date().getFullYear();
const platforms = PLATFORM_KEYS.map((key) => PLATFORMS[key]);
---

<footer class="mt-24 border-t border-line bg-surface/60">
  <div class="container-page py-14 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.25fr_2fr] lg:gap-16">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-soft">
          A focused downloader for public video, audio and captions. No account, no media library,
          no pretending a link worked when it did not.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="tag tag-success"><span class="live-dot" aria-hidden="true"></span> Public links only</span>
          <span class="tag">Temporary files</span>
        </div>
        <p class="mt-5 text-xs leading-relaxed text-muted">
          Only download media you own or have permission to use. Public visibility does not grant
          reuse rights.
        </p>
      </div>

      <div class="grid gap-9 sm:grid-cols-3">
        <div>
          <h2 class="text-[0.68rem] font-[750] uppercase tracking-[0.14em] text-muted">Downloaders</h2>
          <ul class="mt-4 grid gap-2.5">
            {platforms.map((platform) => (
              <li>
                <a href={`/${platform.slug}/`} class="group flex items-center gap-2.5 text-[0.82rem] font-[600] text-soft no-underline transition-colors hover:text-ink">
                  <PlatformIcon platform={platform.key} size="sm" class="h-6 w-6" />
                  {platform.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-[0.68rem] font-[750] uppercase tracking-[0.14em] text-muted">Clipwell</h2>
          <ul class="mt-4 grid gap-2.5 text-[0.82rem] font-[600] text-soft">
            <li><a href="/#how-it-works" class="no-underline hover:text-ink">How it works</a></li>
            <li><a href="/#features" class="no-underline hover:text-ink">Features</a></li>
            <li><a href="/#faq" class="no-underline hover:text-ink">FAQ</a></li>
            <li><a href="/about/" class="no-underline hover:text-ink">About us</a></li>
            <li><a href="/contact/" class="no-underline hover:text-ink">Contact</a></li>
          </ul>
        </div>

        <div>
          <h2 class="text-[0.68rem] font-[750] uppercase tracking-[0.14em] text-muted">Legal</h2>
          <ul class="mt-4 grid gap-2.5 text-[0.82rem] font-[600] text-soft">
            {LEGAL_LINKS.map((link) => (
              <li><a href={link.href} class="no-underline hover:text-ink">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <p>
        Clipwell is an independent utility and is not affiliated with any supported platform.
      </p>
    </div>
  </div>
</footer>
